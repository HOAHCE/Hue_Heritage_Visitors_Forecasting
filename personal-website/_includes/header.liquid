{%- comment -%}
  Bản sao header.liquid của theme al-folio, sửa 2 điểm:

  1. Thanh menu hiển thị theo NGÔN NGỮ của trang đang xem: trang tiếng Việt
     (lang: vi) chỉ hiện các mục tiếng Việt, trang tiếng Anh chỉ hiện mục tiếng Anh.
     Mỗi trang tự khai báo trong front matter: lang, nav, nav_order.
     Trang dùng chung cho cả hai ngôn ngữ (như Blog) khai báo nav_lang: both.

  2. Thêm nút chuyển ngôn ngữ EN / VI nhỏ ở góc trên bên phải, và hiển thị tên
     theo ngôn ngữ (site.name_display / site.name_display_vi trong _config.yml).
     Mỗi trang khai báo địa chỉ trang tương ứng ở ngôn ngữ kia, ví dụ trong
     _pages/teaching.md:  lang_alt: /vi/giang-day/

  LƯU Ý khi nâng cấp theme: nếu al-folio đổi file này, chép lại bản mới từ gem
  rồi áp dụng lại đúng hai thay đổi trên.
{%- endcomment -%}
{%- assign cur_lang = page.lang | default: 'en' -%}
{%- if cur_lang == 'vi' -%}
  {%- assign site_name = site.name_display_vi -%}
  {%- assign home_url = '/vi/' -%}
  {%- assign en_url = page.lang_alt | default: '/' -%}
  {%- assign vi_url = page.url -%}
{%- else -%}
  {%- assign site_name = site.name_display -%}
  {%- assign home_url = '/' -%}
  {%- assign en_url = page.url -%}
  {%- assign vi_url = page.lang_alt | default: '/vi/' -%}
{%- endif -%}
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site_name | default: site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for p in site.pages %}
            {% if p.permalink == home_url %} {% assign about_title = p.nav_title | default: p.title %} {% endif %}
          {% endfor %}

          <!-- Trang chủ (theo ngôn ngữ đang xem) -->
          <li class="nav-item {% if page.permalink == home_url %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}">
              {{- about_title }}
              {% if page.permalink == home_url %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign p_lang = p.nav_lang | default: p.lang | default: 'en' %}
            {% if p.nav and p.autogen == null and p.permalink != home_url and p_lang == cur_lang or p.nav and p.autogen == null and p_lang == 'both' %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.nav_title | default: p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          <!-- Chuyển ngôn ngữ -->
          <li class="nav-item lang-switch">
            <a
              class="lang-opt{% if cur_lang == 'en' %} is-active{% endif %}"
              href="{{ en_url | relative_url }}"
              hreflang="en"
              title="English"
            >EN</a><span class="lang-sep">/</span><a
              class="lang-opt{% if cur_lang == 'vi' %} is-active{% endif %}"
              href="{{ vi_url | relative_url }}"
              hreflang="vi"
              title="Tiếng Việt"
            >VI</a>
          </li>
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
