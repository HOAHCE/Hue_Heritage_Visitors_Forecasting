{%- comment -%}
  Bản sao news.liquid của theme al-folio, sửa một điểm: tin ngắn hiển thị theo ngôn ngữ
  của trang đang xem.

  Cách viết một tin ngắn trong _news/:
      - Phần THÂN BÀI là nội dung tiếng Việt.
      - Trường text_en trong front matter là nội dung tiếng Anh.
  Thiếu text_en thì bản tiếng Anh dùng luôn nội dung tiếng Việt.

  Giữ nội dung tiếng Việt ở thân bài (chứ không phải front matter) là có chủ đích:
  ô tìm kiếm của theme lấy thân bài làm tiêu đề cho tin ngắn, để trống thì mục
  tìm kiếm bị rỗng.
{%- endcomment -%}
{%- assign cur_lang = page.lang | default: 'en' -%}
<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          {% capture item_body %}{{ item.content | remove: '<p>' | remove: '</p>' }}{% endcapture %}
          {% if cur_lang == 'vi' %}
            {% assign item_text = item_body %}
          {% else %}
            {% assign item_text = item.text_en | default: item_body %}
          {% endif %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {{ item_text | emojify }}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% endif %}
</div>
